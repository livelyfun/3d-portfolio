# Optional. Only needed if you want accurate GitHub repo/language stats at build time.
# Without it the build still succeeds and falls back to snapshot values.
# Create a free token with public repo read scope: https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional. Only needed if your Vercel team has system environment variables disabled.
# Vercel auto-populates the URL, so this is a fallback. No protocol, e.g. my-portfolio.vercel.app
NEXT_PUBLIC_SITE_URL=
